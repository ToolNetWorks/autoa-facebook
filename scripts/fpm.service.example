[Unit]
Description=ToolNet Facebook Pipeline Manager
After=network-online.target fpm-desktop.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/facebook-pipeline-manager
ExecStart=/root/facebook-pipeline-manager/scripts/start_app.sh
Restart=always
RestartSec=8
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
